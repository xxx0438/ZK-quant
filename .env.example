# ============================================================
# Echo Protocol API — Environment Configuration
# ============================================================
# Copy to `.env` and fill in real values for your environment.
# NEVER commit `.env` to git.

# ─── Core ────────────────────────────────────────────────────
ENVIRONMENT=development              # development | staging | production
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR

# ─── Database ────────────────────────────────────────────────
# Local dev: docker-compose provides this
# Production: use Supabase / Neon / RDS connection string
DATABASE_URL=postgresql+asyncpg://echo:echo@localhost:5432/echo

# ─── Redis ───────────────────────────────────────────────────
# Local: docker-compose; Production: Upstash / Railway Redis
REDIS_URL=redis://localhost:6379

# ─── Auth / JWT ──────────────────────────────────────────────
# REQUIRED: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
# Must be at least 32 chars in production (validated at startup)
JWT_SECRET=__GENERATE_RANDOM_48_BYTE_TOKEN__
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=168                 # 7 days

# ─── Security: CORS / Hosts ─────────────────────────────────
# Comma-separated; production should NOT use "*"
CORS_ORIGINS=http://localhost:3000,https://echo.ai,https://app.echo.ai
ALLOWED_HOSTS=localhost,127.0.0.1,api.echo.ai

# ─── External Services ───────────────────────────────────────
ENCLAVE_ENDPOINT=http://localhost:9000
MODELS_ENDPOINT=http://localhost:8001
INTELLIGENCE_ENDPOINT=http://localhost:8002

# ─── TEE / Signing ───────────────────────────────────────────
CERT_SIGNING_KEY_PATH=./keys/dev_signing_key.pem
USE_NITRO=false                      # true in AWS production

# ─── Blockchain: Base + USDC ────────────────────────────────
BASE_RPC_URL=https://mainnet.base.org
# Alchemy/Quicknode recommended for production with webhook support:
# BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
USDC_ADDRESS_BASE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
ECHO_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
ECHO_CAPITAL_WALLET=0x0000000000000000000000000000000000000000

# ─── Webhooks ────────────────────────────────────────────────
# Alchemy: https://dashboard.alchemy.com/ → Notify → Address Activity
ALCHEMY_WEBHOOK_SECRET=__set_in_production__

# Coinbase Commerce: https://commerce.coinbase.com/dashboard/settings
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=__set_in_production__

# ─── Observability (optional but recommended) ───────────────
SENTRY_DSN=
POSTHOG_KEY=

# ─── Compliance ──────────────────────────────────────────────
KYC_REQUIRED_ABOVE_USD=1000
GEO_BLOCK_COUNTRIES=IR,KP,SY,CU
